<Window x:Class="Snek.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Snek.Views"
        xmlns:converters="clr-namespace:Snek.Converters"
        mc:Ignorable="d"
        Title="AdminWindow" Height="450" Width="800">
    
    <Window.Resources>
        <converters:ImagePathConverter x:Key="ImageConv"/>
        <converters:ProductBackgroundConverter x:Key="BgConv"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions></Grid.RowDefinitions>
    </Grid>
</Window>
