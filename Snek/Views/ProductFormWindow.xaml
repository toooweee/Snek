<Window x:Class="Snek.Views.ProductFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Snek.Views"
        xmlns:converters="clr-namespace:Snek.Converters"
        mc:Ignorable="d"
        Icon="/Resources/icon.ico"
        Title="ProductFormWindow" Height="450" Width="800">
    
    <Window.Resources>
        <converters:ImagePathConverter x:Key="ImageConv" />
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">

            <!-- Фото -->
            <Border BorderBrush="Gray" BorderThickness="1"
                    Width="300" Height="200" Background="White">
                <Image Source="{Binding ImagePath, Converter={StaticResource ImageConv}}"
                       Stretch="Uniform" />
            </Border>
            <Button Content="Выбрать фото"
                    Command="{Binding PickImageCommand}"
                    HorizontalAlignment="Left" Margin="0,5,0,15" Padding="10,3" />

            <TextBlock Text="Артикул" />
            <TextBox Text="{Binding Art, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsEditMode}"
                     Margin="0,0,0,10" />

            <TextBlock Text="Наименование" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,10" />

            <TextBlock Text="Категория" />
            <ComboBox ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory}"
                      DisplayMemberPath="Name"
                      Margin="0,0,0,10" />

            <TextBlock Text="Производитель" />
            <ComboBox ItemsSource="{Binding Manufacturers}"
                      SelectedItem="{Binding SelectedManufacturer}"
                      DisplayMemberPath="Name"
                      Margin="0,0,0,10" />

            <TextBlock Text="Поставщик" />
            <ComboBox ItemsSource="{Binding Suppliers}"
                      SelectedItem="{Binding SelectedSupplier}"
                      DisplayMemberPath="Name"
                      Margin="0,0,0,10" />

            <TextBlock Text="Единица измерения" />
            <ComboBox ItemsSource="{Binding Units}"
                      SelectedItem="{Binding SelectedUnit}"
                      DisplayMemberPath="Name"
                      Margin="0,0,0,10" />

            <TextBlock Text="Цена (₽)" />
            <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,10" />

            <TextBlock Text="Количество на складе" />
            <TextBox Text="{Binding StockText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,10" />

            <TextBlock Text="Действующая скидка (%)" />
            <TextBox Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,10" />

            <TextBlock Text="Описание" />
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" Height="60" TextWrapping="Wrap"
                     Margin="0,0,0,15" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить" Command="{Binding SaveCommand}"
                        Padding="15,5" Margin="0,0,10,0" />
                <Button Content="Отмена" Command="{Binding CancelCommand}"
                        Padding="15,5" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>